#!/bin/sh

# POSIX shell doesn't support errtrace nor pipefail.

# Exit on error. Append "|| true" if you expect an error.
set -o errexit
# Do not allow use of undefined vars. Use ${VAR:-} to use an undefined VAR.
set -o nounset

BASE_DIR="$(dirname -- "$0")"
G_URL="https://git.io/g-bin"
G_LOCATION="$BASE_DIR/../bin/g"
INSTALL_URL="https://git.io/g-install"
INSTALL_LOCATION="$BASE_DIR/../bin/install"
METADATA_URL="https://go.dev/dl/?mode=json"
METADATA_ALL_URL="https://go.dev/dl/?mode=json&include=all"
METADATA_LOCATION="$BASE_DIR/../tests/fixtures/go-dl.json"
ARCHIVE_URL="https://dl.google.com/go/go1.22.2.linux-amd64.tar.gz"
MIRROR_ARCHIVE_URL="https://mirror.example/go/go1.22.2.linux-amd64.tar.gz"

is_spider=false

if [ -n "${MOCK_URL_LOG:-}" ]; then
  for item in "$@"; do
    case $item in
      http://* | https://*) echo "$item" >> "$MOCK_URL_LOG" ;;
    esac
  done
fi

for item in "$@"; do
  if [ "$item" = "--spider" ]; then
    is_spider=true
  fi
done

for item in "$@"; do
  if [ "$item" = "$G_URL" ]; then
    cat "$G_LOCATION"
    exit 0
  elif [ "$item" = "$INSTALL_URL" ]; then
    cat "$INSTALL_LOCATION"
    exit 0
  elif [ "$item" = "$METADATA_URL" ] || [ "$item" = "$METADATA_ALL_URL" ]; then
    cat "$METADATA_LOCATION"
    exit 0
  elif [ "$item" = "$ARCHIVE_URL" ] || [ "$item" = "$MIRROR_ARCHIVE_URL" ]; then
    if [ "$is_spider" = true ]; then
      printf '  HTTP/1.1 200 OK\n' >&2
    else
      cat "${MOCK_ARCHIVE:?}"
    fi
    exit 0
  fi
done

command "${REAL_WGET:?}" "$@"
